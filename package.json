{
  "name": "notification-service",
  "version": "1.0.0",
  "description": "Servicio de notificaciones del ecosistema CRM (Node + TypeScript + RabbitMQ + Handlebars).",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
