[
  {
    "event": "identity.user.invited",
    "template": "identity.user.invited.html",
    "subject": "Has sido invitado a {{organizationName}}",
    "to": "{{email}}",
    "schema": {
      "type": "object",
      "required": ["email", "organizationName", "inviteUrl"],
      "properties": {
        "email": { "type": "string" },
        "organizationName": { "type": "string", "minLength": 1 },
        "inviteUrl": { "type": "string" }
      }
    }
  },
  {
    "event": "identity.user.enabled",
    "template": "identity.user.enabled.html",
    "subject": "Tu cuenta ha sido reactivada",
    "to": "{{email}}",
    "schema": {
      "type": "object",
      "required": ["email", "organizationName"],
      "properties": {
        "email": { "type": "string" },
        "organizationName": { "type": "string", "minLength": 1 }
      }
    }
  },
  {
    "event": "identity.user.disabled",
    "template": "identity.user.disabled.html",
    "subject": "Tu cuenta ha sido desactivada",
    "to": "{{email}}",
    "schema": {
      "type": "object",
      "required": ["email", "organizationName"],
      "properties": {
        "email": { "type": "string" },
        "organizationName": { "type": "string", "minLength": 1 }
      }
    }
  },
  {
    "event": "identity.user.password_reset_requested",
    "template": "identity.user.password_reset_requested.html",
    "subject": "Restablece tu contraseña en {{organizationName}}",
    "to": "{{email}}",
    "schema": {
      "type": "object",
      "required": ["email", "organizationName", "resetUrl"],
      "properties": {
        "email": { "type": "string" },
        "organizationName": { "type": "string", "minLength": 1 },
        "resetUrl": { "type": "string" }
      }
    }
  },
  {
    "event": "billing.invoice.issued",
    "template": "billing.invoice.issued.html",
    "subject": "Factura {{number}} emitida",
    "to": "{{#if email}}{{email}}{{else}}{{#if issuerSnapshot.email}}{{issuerSnapshot.email}}{{/if}}{{/if}}",
    "allowNullRecipient": true,
    "schema": {
      "type": "object",
      "required": ["invoiceId", "number", "organizationId"],
      "properties": {
        "invoiceId": { "type": "string" },
        "number": { "type": "string", "minLength": 1 },
        "organizationId": { "type": "string" },
        "email": { "type": "string" }
      }
    }
  },
  {
    "event": "billing.invoice.voided",
    "template": "billing.invoice.voided.html",
    "subject": "Factura {{number}} anulada",
    "to": "{{#if email}}{{email}}{{else}}{{#if issuerSnapshot.email}}{{issuerSnapshot.email}}{{/if}}{{/if}}",
    "allowNullRecipient": true,
    "schema": {
      "type": "object",
      "required": ["invoiceId", "number", "organizationId"],
      "properties": {
        "invoiceId": { "type": "string" },
        "number": { "type": "string", "minLength": 1 },
        "organizationId": { "type": "string" }
      }
    }
  },
  {
    "event": "fiscal.ec.invoice.attention_required",
    "template": "fiscal.ec.invoice.attention_required.html",
    "subject": "La factura {{number}} necesita tu atención",
    "to": "{{#if email}}{{email}}{{/if}}",
    "allowNullRecipient": true,
    "schema": {
      "type": "object",
      "required": ["invoiceId", "number", "organizationId", "message"],
      "properties": {
        "invoiceId": { "type": "string" },
        "number": { "type": "string", "minLength": 1 },
        "organizationId": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  },
  {
    "event": "restaurant.reservation.created",
    "template": "restaurant.reservation.created.html",
    "subject": "Reserva confirmada en {{restaurantName}} — {{dateText}}, {{timeText}}",
    "to": "{{guestEmail}}",
    "allowNullRecipient": true,
    "schema": {
      "type": "object",
      "required": ["code", "guestName", "restaurantName", "dateText", "timeText"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "guestName": { "type": "string", "minLength": 1 },
        "guestEmail": { "type": "string" },
        "restaurantName": { "type": "string", "minLength": 1 },
        "dateText": { "type": "string" },
        "timeText": { "type": "string" },
        "manageUrl": { "type": "string" }
      }
    },
    "extra": [
      {
        "template": "restaurant.reservation.created.staff.html",
        "subject": "Nueva reserva: {{guestName}} ({{partySize}} personas) — {{dateText}}, {{timeText}}",
        "to": "{{staffNoticeEmail}}"
      }
    ]
  },
  {
    "event": "restaurant.reservation.cancelled",
    "template": "restaurant.reservation.cancelled.html",
    "subject": "Reserva cancelada en {{restaurantName}}",
    "to": "{{guestEmail}}",
    "allowNullRecipient": true,
    "schema": {
      "type": "object",
      "required": ["code", "guestName", "restaurantName", "dateText", "timeText"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "guestName": { "type": "string", "minLength": 1 },
        "guestEmail": { "type": "string" },
        "restaurantName": { "type": "string", "minLength": 1 },
        "dateText": { "type": "string" },
        "timeText": { "type": "string" },
        "cancelledBy": { "type": "string" }
      }
    },
    "extra": [
      {
        "template": "restaurant.reservation.cancelled.staff.html",
        "subject": "Reserva cancelada: {{guestName}} — {{dateText}}, {{timeText}}",
        "to": "{{staffNoticeEmail}}"
      }
    ]
  },
  {
    "event": "treasury.receivable.overdue",
    "template": "treasury.receivable.overdue.html",
    "subject": "Recordatorio de pago — {{organizationName}}",
    "to": "{{email}}",
    "allowNullRecipient": true,
    "schema": {
      "type": "object",
      "required": ["customerName", "organizationName", "currencyCode"],
      "properties": {
        "customerName": { "type": "string", "minLength": 1 },
        "organizationName": { "type": "string", "minLength": 1 },
        "currencyCode": { "type": "string", "minLength": 1 },
        "email": { "type": "string" }
      }
    }
  }
]
